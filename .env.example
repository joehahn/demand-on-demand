# Copy to .env (chmod 600) and fill in. .env is gitignored; never paste it into a prompt.
ANTHROPIC_API_KEY=sk-ant-...
# Loader / table owner: creates schemas and tables, loads data
DOD_OWNER_DSN=postgresql://dod_owner:<password>@localhost:5432/iowa_liquor
# Agent: read-only on sales/ref/meta, no access to raw; used only inside tool code
DOD_AGENT_DSN=postgresql://dod_agent:<password>@localhost:5432/iowa_liquor
# Raw yearly downloads (~6.5 GB); keep OUTSIDE Dropbox
DOD_DATA_DIR=~/data/demand-on-demand
